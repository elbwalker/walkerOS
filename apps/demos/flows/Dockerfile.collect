# walkerOS server flow on the walkeros/flow runtime.
# Build context: dist/ from `npx walkeros bundle ./server.json -o dist/`.
# WALKEROS_VERSION: the @walkeros/cli version that built dist/ (the matching
# walkeros/flow tag ships runneros). The image supplies BUNDLE, PORT and the
# `runneros start` command.
ARG WALKEROS_VERSION
FROM walkeros/flow:${WALKEROS_VERSION}

COPY . /app/flow/
