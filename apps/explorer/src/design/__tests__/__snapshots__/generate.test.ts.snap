"/* walkerOS design tokens, generated from design/tokens.json by src/design/generate.ts. Edit the JSON, never this file. */

:root, :host, [data-theme] {
  --primary: #01b5e2;
  --code-bg: rgba(41, 45, 62, 1);
  --edge: 0 0 0 1px rgba(0, 0, 0, 0.2);
  --gutter: 24px;
  --radius-md: 8px;
  --z-modal: 50;
  --font-sans: system-ui, 'Segoe UI', sans-serif;
