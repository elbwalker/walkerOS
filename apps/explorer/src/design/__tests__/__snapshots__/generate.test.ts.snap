/* walkerOS design constants, generated from design/tokens.json by src/design/generate.ts. Edit the JSON and run the explorer build, never this file. */

export type Theme = 'dark' | 'light';

/** Page ground. */
export const bg = { dark: "#111827", light: "#ffffff" } as const;

/** Brand fill. */
export const primary = "#01b5e2";

/** Links. */
export const link = { dark: "#4fb3e0", light: "#0076a0" } as const;

/** A single alias of a themed colour. */
export const info = { dark: "#4fb3e0", light: "#0076a0" } as const;

/** A per-theme alias. */
export const focus = { dark: "#01b5e2", light: "#0076a0" } as const;

/** An invariant rgba() colour. */
export const codeBg = "rgba(41, 45, 62, 1)";

/** A single alias of a single literal. */
export const accent = "#01b5e2";

/** Font family \`sans\`. */
export const fontSans = "system-ui, 'Segoe UI', sans-serif";

/** Font family \`mono\`. */
export const fontMono = "ui-monospace, monospace";
