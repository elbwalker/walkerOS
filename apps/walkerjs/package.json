{
  "name": "@walkeros/walker.js",
  "version": "4.6.1",
  "description": "Zero-config walkerOS browser file: data-elb attributes to dataLayer pushes for GTM.",
  "license": "MIT",
  "browser": "./dist/walker.js",
  "jsdelivr": "dist/walker.js",
  "unpkg": "dist/walker.js",
  "sideEffects": true,
  "exports": {
    ".": "./dist/walker.js",
    "./walker.js": "./dist/walker.js"
  },
  "files": [
    "dist/walker.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest --colors --coverage",
    "dev": "jest --watchAll --colors",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf coverage"
  },
  "devDependencies": {
    "@walkeros/collector": "4.6.1",
    "@walkeros/core": "4.6.1",
    "@walkeros/web-source-browser": "4.6.1",
    "@walkeros/web-source-session": "4.6.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "repository": {
    "url": "git+https://github.com/elbwalker/walkerOS.git",
    "directory": "apps/walkerjs"
  },
  "author": "elbwalker <hello@elbwalker.com>",
  "homepage": "https://github.com/elbwalker/walkerOS#readme",
  "bugs": {
    "url": "https://github.com/elbwalker/walkerOS/issues"
  },
  "keywords": [
    "walkerOS",
    "analytics",
    "tracking",
    "data collection",
    "measurement",
    "privacy friendly",
    "web analytics",
    "walker.js"
  ]
}
