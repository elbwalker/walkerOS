# walkeros/cli: the builder image. It carries the full CLI (esbuild, pacote,
# @vercel/nft, npm) and needs registry egress, which is why it is kept apart
# from walkeros/flow, the serving runtime. The hosted bundle job runs this image
# with a per-run command, e.g. `walkeros bundle --manifest <url>`.
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

RUN apk upgrade --no-cache && apk add --no-cache curl

ARG CLI_VERSION=latest
RUN npm install -g @walkeros/cli@${CLI_VERSION}

RUN addgroup -g 1001 walker && \
    adduser -D -u 1001 -G walker walker

USER walker

ENTRYPOINT ["walkeros"]
CMD ["--help"]
