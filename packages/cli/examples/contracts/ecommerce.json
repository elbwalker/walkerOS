{
  "ecommerce": {
    "description": "Events of an online shop, from the first product seen to the refund.",
    "extend": "default",
    "schema": {
      "description": "What every shop event adds.",
      "type": "object",
      "properties": {
        "context": {
          "type": "object",
          "properties": {
            "shopping": {
              "type": "array",
              "description": "The stage of the shopping journey, such as discover, detail, intent, cart, checkout or complete.",
              "prefixItems": [
                {
                  "type": "string",
                  "description": "The stage."
                },
                {
                  "type": "number",
                  "description": "Its order."
                }
              ],
              "examples": [["detail", 0]]
            }
          }
        }
      }
    },
    "events": {
      "product": {
        "view": {
          "title": "Product view",
          "description": "The detail page of a product was shown. Every shop needs it.",
          "examples": [
            {
              "name": "product view",
              "data": {
                "id": "ers",
                "name": "Everyday Ruck Snack",
                "color": "black",
                "size": "l",
                "price": 420,
                "currency": "EUR"
              },
              "context": {
                "shopping": ["detail", 0]
              },
              "globals": {
                "pagegroup": "shop"
              },
              "trigger": "load"
            }
          ],
          "required": ["data"],
          "properties": {
            "data": {
              "type": "object",
              "description": "The product.",
              "required": ["id", "price", "currency"],
              "properties": {
                "id": {
                  "type": ["string", "number"],
                  "description": "The product id, such as the article number.",
                  "examples": ["ers"]
                },
                "name": {
                  "type": "string",
                  "description": "The name of the product.",
                  "examples": ["Everyday Ruck Snack"]
                },
                "category": {
                  "type": "string",
                  "description": "The main category of the product.",
                  "examples": ["Apparel"]
                },
                "brand": {
                  "type": "string",
                  "description": "The brand of the product."
                },
                "variant": {
                  "type": ["string", "number"],
                  "description": "The variant, such as a color.",
                  "examples": ["green"]
                },
                "price": {
                  "type": "number",
                  "description": "The unit price the buyer sees, after any product discount.",
                  "examples": [420]
                },
                "currency": {
                  "type": "string",
                  "description": "The currency of price, as a three-letter code.",
                  "examples": ["EUR"]
                }
              }
            }
