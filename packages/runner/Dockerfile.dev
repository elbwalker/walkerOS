# Dev-only: builds the flow runtime image from local npm pack tarballs.
# Usage (build first: neither package builds on pack, and an unbuilt tarball
# has no dist/):
#   cd walkerOS/packages/runner
#   (cd ../core && npm run build) && npm run build
#   npm pack && npm pack ../core
#   docker build -f Dockerfile.dev -t rg.fr-par.scw.cloud/NAMESPACE/flow:dev .
# Same final stage as Dockerfile; only the package source differs.
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS node

FROM node AS pkg
WORKDIR /app
COPY walkeros-*.tgz /tmp/pkgs/
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund /tmp/pkgs/*.tgz

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk upgrade --no-cache && apk add --no-cache libstdc++ tini

COPY --from=node /usr/local/bin/node /usr/local/bin/node

RUN addgroup -g 1001 walker && \
    adduser -D -u 1001 -G walker walker

WORKDIR /app

COPY --from=pkg /app/node_modules /app/node_modules

RUN mkdir -p /app/flow /app/cache && chown walker:walker /app/flow /app/cache

USER walker

ENV NODE_ENV=production
ENV PORT=8080
ENV BUNDLE=/app/flow/flow.mjs
ENV NODE_OPTIONS=--max-old-space-size=384
ENV PATH="/app/node_modules/.bin:${PATH}"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "const h=require('http');h.get('http://localhost:'+(process.env.PORT||8080)+'/ready',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["runneros", "start"]
