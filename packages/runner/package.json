{
  "name": "@walkeros/runner",
  "version": "4.6.1",
  "description": "walkerOS runner - runs prebuilt walkerOS flow artifacts",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "runneros": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest --colors",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf coverage"
  },
  "dependencies": {
    "@walkeros/core": "4.6.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "tar": "^7.4.0"
  },
  "devDependencies": {
    "@walkeros/config": "4.6.1"
  },
  "repository": {
    "url": "git+https://github.com/elbwalker/walkerOS.git",
    "directory": "packages/runner"
  },
  "author": "elbwalker <hello@elbwalker.com>",
  "keywords": [
    "walkerOS",
    "runner",
    "flow",
    "analytics",
    "event-tracking",
    "server-side"
  ]
}
