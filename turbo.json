{
  "$schema": "https://turbo.build/schema.json",
  "//": "concurrency: 4 with per-task memory bounds (jest workerIdleMemoryLimit) instead of a global throttle; keep the heavy website/docusaurus build out of inner-loop filters. Do not exceed 4 without measuring peak memory at the new concurrency first. dependsOn: ['^build'] is on typecheck ONLY (kept): it preserves strict per-package typecheck (each package checks against upstream compiled .d.ts under its own lib/target), which a single-program source-based typecheck would lose. lint does NOT depend on ^build: eslint here is purely syntactic (@typescript-eslint/parser, no parserOptions.project, no type-aware rules), so it needs no built types. Cold-run speed comes from the remote cache + concurrency, not from weakening typecheck.",
  "globalDependencies": [
    "**/.env.*local",
    "website/.env",
    "packages/config/tsconfig/*.json",
    "packages/config/eslint/**",
    "packages/config/tsup/**",
    "packages/config/jest/**",
    "packages/web/eslint.config.mjs",
    "packages/server/eslint.config.mjs",
    "packages/transformers/eslint.config.mjs",
    "packages/destinations/eslint.config.mjs",
    "packages/mcps/eslint.config.mjs"
  ],
  "concurrency": "4",
  "remoteCache": {
    "enabled": true,
    "signature": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "env": ["CI", "RSPACK_PROGRESS", "DOCUSAURUS_BASEURL"]
    },
    "build:website": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.json",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "lint": {
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.mjs",
        "eslint.config.*",
        ".eslintrc*",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.json",
        "src/**/*.snap",
        "src/**/__fixtures__/**",
        "jest.config.*",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "update": {}
  }
}
