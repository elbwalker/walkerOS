{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@walkeros/storybook-demo#build"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "scripts/**",
        "docs/**",
        "docusaurus.config.ts",
        "src/css/custom.css",
        "static/fonts/**",
        "$TURBO_ROOT$/skills/INDEX.json",
        "$TURBO_ROOT$/apps/scripts/validate-llms.ts"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "src/**/*.jsx",
        "src/**/*.cjs",
        "src/**/*.css",
        "src/**/*.scss",
        "src/**/*.mdx",
        "src/**/*.html",
        "src/**/*.svg"
      ]
    }
  }
}
